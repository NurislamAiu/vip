rules_version = '2';

// Security model:
//  - Unauthenticated users have no access at all.
//  - Every request is gated on the caller having an *active* profile document.
//  - Administrators: full read/write, including deletes and staff management.
//  - Managers: read + create + update on clients; NO deletes; no staff writes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's own profile. get() bypasses rules, so this is safe
    // to call from within other rules without recursion.
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().isActive == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'administrator';
    }

    match /users/{userId} {
      // A signed-in user may always read their OWN profile — even before it is
      // set up or if it has been disabled — so the app can resolve state and
      // show a clear message instead of a permission error. Admins read anyone.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Admins provision staff. A signed-in user may also create their OWN
      // profile once — first-run bootstrap for the owner account created in the
      // Firebase console (admin-provisioned staff already have a document).
      allow create: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.isActive == true);

      // Only admins edit, disable or remove staff.
      allow update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if isActive();
      // Deletion is administrator-only.
      allow delete: if isAdmin();
    }
  }
}
